<configuration>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Without this file logback defaults to DEBUG and floods the log with Netty internals. -->
    <root level="INFO">
        <appender-ref ref="STDOUT"/>
    </root>
</configuration>
